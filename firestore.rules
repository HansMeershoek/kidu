rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // Fase 1 read-only: a household that has been wound down (the other
    // co-parent left / the household was ended) but whose remaining member
    // may still view and export the existing administration. A missing
    // `isReadOnly` field is treated as false (same semantics as the client).
    function isHouseholdReadOnly(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId))
        && ('isReadOnly' in get(/databases/$(database)/documents/households/$(householdId)).data)
        && get(/databases/$(database)/documents/households/$(householdId)).data.isReadOnly == true;
    }

    function isRecurringMasterCreator(householdId, recurringId) {
      return exists(/databases/$(database)/documents/households/$(householdId)/recurringExpenses/$(recurringId))
        && get(/databases/$(database)/documents/households/$(householdId)/recurringExpenses/$(recurringId)).data.createdBy == request.auth.uid;
    }

    // Private note share list: max 3 viewers, non-empty string uids, household
    // members only, owner not listed, no duplicates (unfolded; no loops).
    function privateNoteSharedWithUidsValid(householdId, ownerUid, listValue) {
      return listValue is list
        && listValue.size() <= 3
        && (listValue.size() < 2 || listValue[0] != listValue[1])
        && (listValue.size() < 3
            || (listValue[0] != listValue[2] && listValue[1] != listValue[2]))
        && (listValue.size() < 1
            || (listValue[0] is string
                && listValue[0].size() > 0
                && listValue[0] != ownerUid
                && exists(/databases/$(database)/documents/households/$(householdId)/members/$(listValue[0]))))
        && (listValue.size() < 2
            || (listValue[1] is string
                && listValue[1].size() > 0
                && listValue[1] != ownerUid
                && exists(/databases/$(database)/documents/households/$(householdId)/members/$(listValue[1]))))
        && (listValue.size() < 3
            || (listValue[2] is string
                && listValue[2].size() > 0
                && listValue[2] != ownerUid
                && exists(/databases/$(database)/documents/households/$(householdId)/members/$(listValue[2]))));
    }

    function sameHouseholdUser(targetUserId) {
      let requesterUser = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let targetUser = get(/databases/$(database)/documents/users/$(targetUserId));
      return request.auth != null
        && requesterUser != null
        && targetUser != null
        && 'householdId' in requesterUser.data
        && requesterUser.data.householdId is string
        && requesterUser.data.householdId.size() > 0
        && 'householdId' in targetUser.data
        && targetUser.data.householdId is string
        && targetUser.data.householdId.size() > 0
        && requesterUser.data.householdId == targetUser.data.householdId
        && exists(/databases/$(database)/documents/households/$(requesterUser.data.householdId)/members/$(request.auth.uid))
        && exists(/databases/$(database)/documents/households/$(requesterUser.data.householdId)/members/$(targetUserId));
    }

    function userHouseholdIdSafe() {
      return !('householdId' in request.resource.data)
        || request.resource.data.householdId == null
        || request.resource.data.householdId is string;
    }

    function userWriteValidKeys() {
      let allowed = [
        'profileName',
        'householdId',
        'displayName',
        'email',
        'photoUrl',
        'createdAt',
        'updatedAt',
        'setupCompletedAt'
      ];
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(allowed);
    }

    function userNoPrivilegeKeys() {
      return !('role' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('admin' in request.resource.data);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || sameHouseholdUser(userId));

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().size() <= 8
        && userHouseholdIdSafe()
        && userNoPrivilegeKeys()
        && (!('profileName' in request.resource.data)
            || (request.resource.data.profileName is string
                && request.resource.data.profileName.size() >= 0
                && request.resource.data.profileName.size() <= 40))
        && (!('householdId' in request.resource.data)
            || request.resource.data.householdId == null
            || (request.resource.data.householdId is string))
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || request.resource.data.displayName is string)
        && (!('email' in request.resource.data)
            || request.resource.data.email == null
            || request.resource.data.email is string)
        && (!('photoUrl' in request.resource.data)
            || request.resource.data.photoUrl == null
            || request.resource.data.photoUrl is string);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && userWriteValidKeys()
        && userHouseholdIdSafe()
        && userNoPrivilegeKeys()
        // Fase 3: account-delete batch minimizes the caller's own doc and
        // sets profileName to null (same null-allowance already granted to
        // email/photoUrl below).
        && (!('profileName' in request.resource.data)
            || request.resource.data.profileName == null
            || (request.resource.data.profileName is string
                && request.resource.data.profileName.size() >= 0
                && request.resource.data.profileName.size() <= 40))
        && (!('householdId' in request.resource.data)
            || request.resource.data.householdId == null
            || (request.resource.data.householdId is string))
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName == null
            || request.resource.data.displayName is string)
        && (!('email' in request.resource.data)
            || request.resource.data.email == null
            || request.resource.data.email is string)
        && (!('photoUrl' in request.resource.data)
            || request.resource.data.photoUrl == null
            || request.resource.data.photoUrl is string);

      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'createdBy',
          'name',
          'isConnected'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isConnected == false;

      // Two disjoint update paths:
      //  1. Existing 'isConnected' flip (unchanged behavior), now also
      //     hard-blocked once the household is read-only.
      //  2. Fase 1 preparation only: a future delete-flow may flip a
      //     household from active to read-only. Not called from the app
      //     yet in Fase 1 (no UI sets these fields), but the rule is
      //     already safe: existing member only, strictly these four
      //     fields, and only false -> true (never back to false).
      allow update: if isSignedIn()
        && isHouseholdMember(householdId)
        && (
          (
            !isHouseholdReadOnly(householdId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isConnected'])
            && request.resource.data.isConnected == true
          )
          || (
            (!('isReadOnly' in resource.data) || resource.data.isReadOnly == false)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isReadOnly',
              'readOnlyAt',
              'readOnlyReason',
              'readOnlyBy'
            ])
            && request.resource.data.isReadOnly == true
            && request.resource.data.readOnlyAt == request.time
            && (!('readOnlyReason' in request.resource.data)
                || (request.resource.data.readOnlyReason is string
                    && request.resource.data.readOnlyReason.size() <= 500))
            && (!('readOnlyBy' in request.resource.data)
                || request.resource.data.readOnlyBy == request.auth.uid)
          )
        );

      allow delete: if false;
    }

    match /households/{householdId}/members/{memberId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      // Fase 1 read-only: a read-only (ended) household may not be actively
      // re-joined/re-linked.
      allow create: if isSignedIn()
        && request.auth.uid == memberId
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.keys().hasOnly(['role', 'joinedAt'])
        && request.resource.data.role is string;

      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == memberId;
    }

    match /households/{householdId}/children/{childId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.keys().hasOnly([
          'name',
          'createdAt',
          'createdBy',
          'isArchived',
          'isDeleted'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && (!('isArchived' in request.resource.data)
            || request.resource.data.isArchived == false)
        && (!('isDeleted' in request.resource.data)
            || request.resource.data.isDeleted == false);

      allow update: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'updatedAt'
        ])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() >= 1
                && request.resource.data.name.size() <= 40))
        && (!('isArchived' in request.resource.data)
            || request.resource.data.isArchived is bool)
        && (!('isDeleted' in request.resource.data)
            || request.resource.data.isDeleted is bool)
        && (!('deletedAt' in request.resource.data)
            || request.resource.data.deletedAt is timestamp)
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp)
        && (!(request.resource.data.isDeleted == true)
            || request.resource.data.isArchived == true)
        && (!('deletedAt' in request.resource.data)
            || request.resource.data.isDeleted == true);

      allow delete: if false;
    }

    match /households/{householdId}/expenses/{expenseId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'amountCents',
          'currency',
          'title',
          'createdAt',
          'createdBy',
          'childIds',
          'recurringExpenseId',
          'periodKey',
          'materializedAt',
          'parentSplitParticipantUids',
          'parentSplit0ShareBps',
          'privateNoteSharedWithUids'
        ])
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && (!('childIds' in request.resource.data)
            || request.resource.data.childIds == null
            || (request.resource.data.childIds is list
                && request.resource.data.childIds.size() <= 7))
        // Parent-split snapshot: both fields together, or neither; two
        // distinct member-uids. Snapshot bps may be 0..10000 (one-time or
        // materialized recurring). Concrete expenses may update snapshot
        // fields via expense update-rule (creator-only; see below).
        && (('parentSplitParticipantUids' in request.resource.data)
            == ('parentSplit0ShareBps' in request.resource.data))
        && (!('parentSplitParticipantUids' in request.resource.data)
            || (request.resource.data.parentSplitParticipantUids is list
                && request.resource.data.parentSplitParticipantUids.size() == 2
                && request.resource.data.parentSplitParticipantUids[0] is string
                && request.resource.data.parentSplitParticipantUids[1] is string
                && request.resource.data.parentSplitParticipantUids[0].size() > 0
                && request.resource.data.parentSplitParticipantUids[1].size() > 0
                && request.resource.data.parentSplitParticipantUids[0]
                   != request.resource.data.parentSplitParticipantUids[1]
                && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.parentSplitParticipantUids[0]))
                && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.parentSplitParticipantUids[1]))
                && request.resource.data.parentSplit0ShareBps is int
                && request.resource.data.parentSplit0ShareBps >= 0
                && request.resource.data.parentSplit0ShareBps <= 10000))
        && (!('materializedAt' in request.resource.data)
            || request.resource.data.materializedAt is timestamp)
        && (('recurringExpenseId' in request.resource.data)
            == ('periodKey' in request.resource.data))
        && (!('recurringExpenseId' in request.resource.data)
            || (request.resource.data.recurringExpenseId is string
                && request.resource.data.recurringExpenseId.size() > 0
                && request.resource.data.periodKey is string
                && request.resource.data.periodKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                && isRecurringMasterCreator(householdId, request.resource.data.recurringExpenseId)
                && get(/databases/$(database)/documents/households/$(householdId)/recurringExpenses/$(request.resource.data.recurringExpenseId)).data.status == 'active'
                && request.resource.data.createdAt is timestamp
                && expenseId == 'rec_' + request.resource.data.recurringExpenseId + '_' + request.resource.data.periodKey))
        // Parent-level mirror of the private note share-state. Hint/gate for
        // clients only; never carries note content. Owner is the expense
        // creator at create-time.
        && (!('privateNoteSharedWithUids' in request.resource.data)
            || privateNoteSharedWithUidsValid(
              householdId,
              request.resource.data.createdBy,
              request.resource.data.privateNoteSharedWithUids
            ));

      allow update: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amountCents',
          'title',
          'childIds',
          'parentSplitParticipantUids',
          'parentSplit0ShareBps',
          'hasAuditHistory',
          'privateNoteSharedWithUids'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'hasAuditHistory'
            ])
            || request.resource.data.hasAuditHistory == true)
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 0
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && (!('childIds' in request.resource.data)
            || request.resource.data.childIds == null
            || (request.resource.data.childIds is list
                && request.resource.data.childIds.size() <= 7))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'parentSplitParticipantUids',
              'parentSplit0ShareBps'
            ])
            || (
              ('parentSplitParticipantUids' in request.resource.data)
              && ('parentSplit0ShareBps' in request.resource.data)
              && request.resource.data.parentSplitParticipantUids is list
              && request.resource.data.parentSplitParticipantUids.size() == 2
              && request.resource.data.parentSplitParticipantUids[0] is string
              && request.resource.data.parentSplitParticipantUids[1] is string
              && request.resource.data.parentSplitParticipantUids[0].size() > 0
              && request.resource.data.parentSplitParticipantUids[1].size() > 0
              && request.resource.data.parentSplitParticipantUids[0]
                 != request.resource.data.parentSplitParticipantUids[1]
              && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.parentSplitParticipantUids[0]))
              && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.parentSplitParticipantUids[1]))
              && request.resource.data.parentSplit0ShareBps is int
              && request.resource.data.parentSplit0ShareBps >= 0
              && request.resource.data.parentSplit0ShareBps <= 10000))
        // Parent-level mirror of the private note share-state. createdBy is
        // immutable on update (not in the affected-keys list), so the owner
        // is read from the existing document.
        && (!('privateNoteSharedWithUids' in request.resource.data)
            || privateNoteSharedWithUidsValid(
              householdId,
              resource.data.createdBy,
              request.resource.data.privateNoteSharedWithUids
            ));

      allow delete: if false;
    }

    match /households/{householdId}/recurringExpenses/{recurringId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'title',
          'amountCents',
          'currency',
          'childIds',
          'startDate',
          'dueDayOfMonth',
          'cadence',
          'status',
          'materializeFromDate',
          'recurringParentSplitParticipantUids',
          'recurringParentSplit0ShareBps',
          'createdAt',
          'createdBy',
          'updatedAt',
          'privateNoteSharedWithUids'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.childIds is list
        && request.resource.data.childIds.size() >= 1
        && request.resource.data.childIds.size() <= 7
        && request.resource.data.startDate is timestamp
        && request.resource.data.startDate >= request.time - duration.value(1, 'd')
        && request.resource.data.dueDayOfMonth is int
        && request.resource.data.dueDayOfMonth >= 1
        && request.resource.data.dueDayOfMonth <= 31
        && request.resource.data.cadence == 'monthly'
        && request.resource.data.status == 'active'
        && request.resource.data.materializeFromDate is timestamp
        && request.resource.data.materializeFromDate == request.resource.data.startDate
        && request.resource.data.recurringParentSplitParticipantUids is list
        && request.resource.data.recurringParentSplitParticipantUids.size() == 2
        && request.resource.data.recurringParentSplitParticipantUids[0] is string
        && request.resource.data.recurringParentSplitParticipantUids[1] is string
        && request.resource.data.recurringParentSplitParticipantUids[0].size() > 0
        && request.resource.data.recurringParentSplitParticipantUids[1].size() > 0
        && request.resource.data.recurringParentSplitParticipantUids[0]
           != request.resource.data.recurringParentSplitParticipantUids[1]
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.recurringParentSplitParticipantUids[0]))
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.recurringParentSplitParticipantUids[1]))
        && request.resource.data.recurringParentSplit0ShareBps is int
        && request.resource.data.recurringParentSplit0ShareBps >= 0
        && request.resource.data.recurringParentSplit0ShareBps <= 10000
        && request.resource.data.createdAt == request.time
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt == request.time)
        // Parent-level mirror of the recurring private note share-state.
        // Owner is the recurring master creator at create-time.
        && (!('privateNoteSharedWithUids' in request.resource.data)
            || privateNoteSharedWithUidsValid(
              householdId,
              request.resource.data.createdBy,
              request.resource.data.privateNoteSharedWithUids
            ));

      allow update: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.cadence == resource.data.cadence
        && request.resource.data.startDate == resource.data.startDate
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'amountCents',
          'childIds',
          'status',
          'dueDayOfMonth',
          'materializeFromDate',
          'recurringParentSplitParticipantUids',
          'recurringParentSplit0ShareBps',
          'updatedAt',
          'privateNoteSharedWithUids'
        ])
        && request.resource.data.updatedAt == request.time
        && (('recurringParentSplitParticipantUids' in request.resource.data)
            == ('recurringParentSplit0ShareBps' in request.resource.data))
        && (!('recurringParentSplitParticipantUids' in request.resource.data)
            || (request.resource.data.recurringParentSplitParticipantUids is list
                && request.resource.data.recurringParentSplitParticipantUids.size() == 2
                && request.resource.data.recurringParentSplitParticipantUids[0] is string
                && request.resource.data.recurringParentSplitParticipantUids[1] is string
                && request.resource.data.recurringParentSplitParticipantUids[0].size() > 0
                && request.resource.data.recurringParentSplitParticipantUids[1].size() > 0
                && request.resource.data.recurringParentSplitParticipantUids[0]
                   != request.resource.data.recurringParentSplitParticipantUids[1]
                && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.recurringParentSplitParticipantUids[0]))
                && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.recurringParentSplitParticipantUids[1]))
                && request.resource.data.recurringParentSplit0ShareBps is int
                && request.resource.data.recurringParentSplit0ShareBps >= 0
                && request.resource.data.recurringParentSplit0ShareBps <= 10000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title'])
            || (request.resource.data.title is string
                && request.resource.data.title.size() >= 1
                && request.resource.data.title.size() <= 60))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amountCents'])
            || (request.resource.data.amountCents is int
                && request.resource.data.amountCents > 0))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['childIds'])
            || (request.resource.data.childIds is list
                && request.resource.data.childIds.size() >= 1
                && request.resource.data.childIds.size() <= 7))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dueDayOfMonth'])
            || (request.resource.data.dueDayOfMonth is int
                && request.resource.data.dueDayOfMonth >= 1
                && request.resource.data.dueDayOfMonth <= 31))
        // Ondergrens: materializeFromDate mag tot ca. 48 uur vóór request.time (UTC)
        // liggen zodat lokale kalenderdagen 00:00 en TZ/DST geen false denies geven;
        // periodKey + deterministic rec_*-id + create-only tx houden duplicates tegen.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['materializeFromDate'])
            || (request.resource.data.materializeFromDate is timestamp
                && request.resource.data.materializeFromDate >= request.time - duration.value(48, 'h')))
        && request.resource.data.status in ['active', 'paused']
        // Parent-level mirror of the recurring private note share-state.
        // createdBy is pinned unchanged above, so owner is read from the
        // existing document.
        && (!('privateNoteSharedWithUids' in request.resource.data)
            || privateNoteSharedWithUidsValid(
              householdId,
              resource.data.createdBy,
              request.resource.data.privateNoteSharedWithUids
            ));

      // Creator-only hard delete of the recurring master.
      // Allowed from both 'active' and 'paused'. Stops only future monthly
      // materializations; already-materialized expenses are intentionally
      // NOT deleted by this rule (expense delete stays disallowed below).
      allow delete: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.auth.uid == resource.data.createdBy
        && resource.data.status in ['active', 'paused'];
    }

    match /households/{householdId}/recurringExpenses/{recurringId}/changes/{changeId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && isRecurringMasterCreator(householdId, recurringId)
        && request.resource.data.keys().hasOnly([
          'changeType',
          'fromAmountCents',
          'toAmountCents',
          'fromStatus',
          'toStatus',
          'fromTitle',
          'toTitle',
          'fromChildIds',
          'toChildIds',
          'reason',
          'editedBy',
          'editedAt'
        ])
        && request.resource.data.changeType is string
        && request.resource.data.changeType in ['amount', 'status', 'title', 'children']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.editedAt == request.time
        && (request.resource.data.changeType != 'amount'
            || ('fromAmountCents' in request.resource.data
                && 'toAmountCents' in request.resource.data
                && !('fromStatus' in request.resource.data)
                && !('toStatus' in request.resource.data)
                && !('fromTitle' in request.resource.data)
                && !('toTitle' in request.resource.data)
                && !('fromChildIds' in request.resource.data)
                && !('toChildIds' in request.resource.data)))
        && (request.resource.data.changeType != 'status'
            || ('fromStatus' in request.resource.data
                && 'toStatus' in request.resource.data
                && !('fromAmountCents' in request.resource.data)
                && !('toAmountCents' in request.resource.data)
                && !('fromTitle' in request.resource.data)
                && !('toTitle' in request.resource.data)
                && !('fromChildIds' in request.resource.data)
                && !('toChildIds' in request.resource.data)))
        && (request.resource.data.changeType != 'title'
            || ('fromTitle' in request.resource.data
                && 'toTitle' in request.resource.data
                && !('fromAmountCents' in request.resource.data)
                && !('toAmountCents' in request.resource.data)
                && !('fromStatus' in request.resource.data)
                && !('toStatus' in request.resource.data)
                && !('fromChildIds' in request.resource.data)
                && !('toChildIds' in request.resource.data)))
        && (request.resource.data.changeType != 'children'
            || ('fromChildIds' in request.resource.data
                && 'toChildIds' in request.resource.data
                && !('fromAmountCents' in request.resource.data)
                && !('toAmountCents' in request.resource.data)
                && !('fromStatus' in request.resource.data)
                && !('toStatus' in request.resource.data)
                && !('fromTitle' in request.resource.data)
                && !('toTitle' in request.resource.data)))
        && (!('fromAmountCents' in request.resource.data)
            || (request.resource.data.fromAmountCents is int
                && request.resource.data.toAmountCents is int
                && request.resource.data.toAmountCents != request.resource.data.fromAmountCents))
        && (!('fromStatus' in request.resource.data)
            || (request.resource.data.fromStatus in ['active', 'paused']
                && request.resource.data.toStatus in ['active', 'paused']
                && request.resource.data.fromStatus != request.resource.data.toStatus))
        && (!('fromTitle' in request.resource.data)
            || (request.resource.data.fromTitle is string
                && request.resource.data.toTitle is string
                && request.resource.data.fromTitle.size() >= 1
                && request.resource.data.fromTitle.size() <= 60
                && request.resource.data.toTitle.size() >= 1
                && request.resource.data.toTitle.size() <= 60
                && request.resource.data.fromTitle != request.resource.data.toTitle))
        && (!('fromChildIds' in request.resource.data)
            || (request.resource.data.fromChildIds is list
                && request.resource.data.toChildIds is list
                && request.resource.data.fromChildIds.size() >= 1
                && request.resource.data.fromChildIds.size() <= 7
                && request.resource.data.toChildIds.size() >= 1
                && request.resource.data.toChildIds.size() <= 7
                && request.resource.data.fromChildIds != request.resource.data.toChildIds));

      allow update: if false;

      // Creator-only delete, solely for cleanup when the recurring master
      // is being deleted. Must run while the master still exists because
      // isRecurringMasterCreator resolves against the master document.
      allow delete: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && isRecurringMasterCreator(householdId, recurringId);
    }

    match /households/{householdId}/recurringExpenses/{recurringId}/privateNotes/{uid} {
      allow get: if isSignedIn()
        && isHouseholdMember(householdId)
        && (
          (
            request.auth.uid == uid
            && isRecurringMasterCreator(householdId, recurringId)
          )
          || (
            exists(/databases/$(database)/documents/households/$(householdId)/recurringExpenses/$(recurringId))
            && get(/databases/$(database)/documents/households/$(householdId)/recurringExpenses/$(recurringId)).data.createdBy == uid
            && 'sharedWithUids' in resource.data
            && resource.data.sharedWithUids is list
            && request.auth.uid in resource.data.sharedWithUids
            && privateNoteSharedWithUidsValid(
              householdId,
              uid,
              resource.data.sharedWithUids
            )
            && 'note' in resource.data
            && resource.data.note is string
            && resource.data.note.size() >= 1
          )
        );

      allow list: if false;

      // Create is intentionally split from update so a private note may be
      // written in the same WriteBatch as the recurring master. Firestore
      // rules cannot observe sibling writes in the same batch, so requiring
      // isRecurringMasterCreator at create-time would always fail when the
      // master is being created in that same commit. Ownership stays hard
      // on get/update/delete below. The uid in the path plus
      // request.auth.uid == uid prevents writing under another user's slot.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.keys().hasOnly([
          'note',
          'updatedAt',
          'sharedWithUids'
        ])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 180
        && request.resource.data.updatedAt == request.time
        && (!('sharedWithUids' in request.resource.data)
            || privateNoteSharedWithUidsValid(
              householdId,
              uid,
              request.resource.data.sharedWithUids
            ));

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && isRecurringMasterCreator(householdId, recurringId)
        && request.resource.data.keys().hasOnly([
          'note',
          'updatedAt',
          'sharedWithUids'
        ])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 180
        && request.resource.data.updatedAt == request.time
        && (!('sharedWithUids' in request.resource.data)
            || privateNoteSharedWithUidsValid(
              householdId,
              uid,
              request.resource.data.sharedWithUids
            ));

      // Delete is deliberately broader than get/update: the creator of the
      // recurring master must be able to clean up ALL uid-slots under this
      // master (not only their own) when deleting the master, otherwise
      // privateNotes written by co-parents remain as orphans once the
      // parent master is removed. Still creator-only, still scoped to the
      // household, and still requires the master to exist (so this must
      // run BEFORE the master itself is deleted).
      allow delete: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && isRecurringMasterCreator(householdId, recurringId);
    }

    match /households/{householdId}/expenses/{expenseId}/amountEdits/{editId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && exists(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId))
        && get(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId)).data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'fromAmountCents',
          'toAmountCents',
          'reason',
          'editedBy',
          'editedAt',
          'changeBatchId'
        ])
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.fromAmountCents is int
        && request.resource.data.fromAmountCents >= 0
        && request.resource.data.toAmountCents is int
        && request.resource.data.toAmountCents >= 0
        && request.resource.data.toAmountCents != request.resource.data.fromAmountCents
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.editedAt == request.time
        && request.resource.data.fromAmountCents
         == get(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId)).data.amountCents
        && (!('changeBatchId' in request.resource.data)
            || (request.resource.data.changeBatchId is string
                && request.resource.data.changeBatchId.size() > 0
                && request.resource.data.changeBatchId.size() <= 128));

      allow update, delete: if false;
    }

    match /households/{householdId}/expenses/{expenseId}/expenseChanges/{changeId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && exists(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId))
        && get(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId)).data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'editedBy',
          'editedAt',
          'reason',
          'priorChildIds',
          'childIds',
          'priorSplitParticipantUids',
          'priorSplit0ShareBps',
          'splitParticipantUids',
          'split0ShareBps',
          'changeBatchId'
        ])
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.editedAt == request.time
        && request.resource.data.priorChildIds is list
        && request.resource.data.priorChildIds.size() <= 7
        && request.resource.data.childIds is list
        && request.resource.data.childIds.size() <= 7
        && (!('changeBatchId' in request.resource.data)
            || (request.resource.data.changeBatchId is string
                && request.resource.data.changeBatchId.size() > 0
                && request.resource.data.changeBatchId.size() <= 128))
        && (
          (!('priorSplitParticipantUids' in request.resource.data)
            && !('priorSplit0ShareBps' in request.resource.data)
            && !('splitParticipantUids' in request.resource.data)
            && !('split0ShareBps' in request.resource.data))
          ||
          ('priorSplitParticipantUids' in request.resource.data
            && ('priorSplit0ShareBps' in request.resource.data)
            && ('splitParticipantUids' in request.resource.data)
            && ('split0ShareBps' in request.resource.data)
          )
        )
        && ((!('priorSplitParticipantUids' in request.resource.data))
            || (
              request.resource.data.priorSplitParticipantUids is list
              && request.resource.data.priorSplitParticipantUids.size() == 2
              && request.resource.data.priorSplitParticipantUids[0] is string
              && request.resource.data.priorSplitParticipantUids[1] is string
              && request.resource.data.priorSplitParticipantUids[0].size() > 0
              && request.resource.data.priorSplitParticipantUids[1].size() > 0
              && request.resource.data.priorSplitParticipantUids[0]
                 != request.resource.data.priorSplitParticipantUids[1]
              && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.priorSplitParticipantUids[0]))
              && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.priorSplitParticipantUids[1]))
              && request.resource.data.priorSplit0ShareBps is int
              && request.resource.data.priorSplit0ShareBps >= 0
              && request.resource.data.priorSplit0ShareBps <= 10000
              && request.resource.data.splitParticipantUids is list
              && request.resource.data.splitParticipantUids.size() == 2
              && request.resource.data.splitParticipantUids[0] is string
              && request.resource.data.splitParticipantUids[1] is string
              && request.resource.data.splitParticipantUids[0].size() > 0
              && request.resource.data.splitParticipantUids[1].size() > 0
              && request.resource.data.splitParticipantUids[0]
                 != request.resource.data.splitParticipantUids[1]
              && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.splitParticipantUids[0]))
              && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.splitParticipantUids[1]))
              && request.resource.data.split0ShareBps is int
              && request.resource.data.split0ShareBps >= 0
              && request.resource.data.split0ShareBps <= 10000));

      allow update, delete: if false;
    }

    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      // Fase 1 read-only: no new invite may be created for a read-only
      // (ended) household.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'householdId',
          'createdBy',
          'usedBy',
          'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && isHouseholdMember(request.resource.data.householdId)
        && !isHouseholdReadOnly(request.resource.data.householdId);

      // Fase 1 read-only: joining (claiming) an invite that points at a
      // read-only household is blocked here too, in addition to the
      // members-create guard above (belt-and-suspenders: this stops the
      // invite claim itself, the members guard stops the membership write).
      allow update: if isSignedIn()
        && resource.data.usedBy == null
        && !isHouseholdReadOnly(resource.data.householdId)
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        )
        && (!('usedAt' in request.resource.data)
            || request.resource.data.usedAt == request.time);

      allow delete: if false;
    }

    match /households/{householdId}/settlements/{settlementId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);
      allow create, update, delete: if false;
    }

    match /households/{householdId}/payments/{paymentId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.keys().hasOnly([
          'amountCents',
          'currency',
          'fromUserId',
          'toUserId',
          'status',
          'createdAt',
          'createdBy',
          'confirmedAt',
          'confirmedBy',
          'revision'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId.size() > 0
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.revision is int
        && request.resource.data.revision == 0
        && (!('confirmedAt' in request.resource.data) || request.resource.data.confirmedAt == null)
        && (!('confirmedBy' in request.resource.data) || request.resource.data.confirmedBy == null);

      // Two pending-payment update paths:
      // 1) Receiver confirms (status only; amount + revision immutable).
      // 2) Payer/createdBy edits amountCents with revision exactly +1.
      allow update: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && (
          (
            request.auth.uid == resource.data.toUserId
            && resource.data.status == 'pending'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'confirmedAt',
              'confirmedBy'
            ])
            && request.resource.data.confirmedAt == request.time
            && request.resource.data.confirmedBy == request.auth.uid
            && request.resource.data.amountCents == resource.data.amountCents
            && request.resource.data.currency == resource.data.currency
            && request.resource.data.fromUserId == resource.data.fromUserId
            && request.resource.data.toUserId == resource.data.toUserId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && (
              (!('revision' in resource.data) && !('revision' in request.resource.data))
              || (
                ('revision' in resource.data)
                && ('revision' in request.resource.data)
                && request.resource.data.revision == resource.data.revision
              )
            )
          )
          || (
            request.auth.uid == resource.data.fromUserId
            && request.auth.uid == resource.data.createdBy
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'amountCents',
              'revision'
            ])
            && request.resource.data.amountCents is int
            && request.resource.data.amountCents > 0
            && request.resource.data.amountCents != resource.data.amountCents
            && request.resource.data.revision is int
            && request.resource.data.revision
               == (('revision' in resource.data) ? resource.data.revision : 0) + 1
            && request.resource.data.currency == resource.data.currency
            && request.resource.data.fromUserId == resource.data.fromUserId
            && request.resource.data.toUserId == resource.data.toUserId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && (
              (!('confirmedAt' in request.resource.data)
                || request.resource.data.confirmedAt == resource.data.confirmedAt)
            )
            && (
              (!('confirmedBy' in request.resource.data)
                || request.resource.data.confirmedBy == resource.data.confirmedBy)
            )
          )
        );

      allow delete: if false;

      match /amountEdits/{editId} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);

        // History create must ride in the same batch/transaction as a
        // pending payment amount+revision update. get() = state before the
        // atomic write; getAfter() = projected payment state after it.
        allow create: if isSignedIn()
          && isHouseholdMember(householdId)
          && !isHouseholdReadOnly(householdId)
          && exists(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId))
          && existsAfter(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId))
          && get(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.status == 'pending'
          && get(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.fromUserId == request.auth.uid
          && get(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.status == 'pending'
          && getAfter(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.amountCents
             != get(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.amountCents
          && getAfter(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.revision is int
          && getAfter(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.revision
             == (('revision' in get(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data)
                 ? get(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.revision
                 : 0) + 1
          && request.resource.data.keys().hasOnly([
            'fromAmountCents',
            'toAmountCents',
            'reason',
            'editedBy',
            'editedAt'
          ])
          && request.resource.data.editedBy == request.auth.uid
          && request.resource.data.fromAmountCents is int
          && request.resource.data.toAmountCents is int
          && request.resource.data.toAmountCents > 0
          && request.resource.data.toAmountCents != request.resource.data.fromAmountCents
          && request.resource.data.fromAmountCents
           == get(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.amountCents
          && request.resource.data.toAmountCents
           == getAfter(/databases/$(database)/documents/households/$(householdId)/payments/$(paymentId)).data.amountCents
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 1
          && request.resource.data.reason.size() <= 500
          && request.resource.data.reason.matches('.*\\S.*')
          && request.resource.data.reason
             == request.resource.data.reason.trim()
          && request.resource.data.editedAt == request.time;

        allow update, delete: if false;
      }
    }

    match /households/{householdId}/expenses/{expenseId}/privateNotes/{uid} {
      allow get: if isSignedIn()
        && isHouseholdMember(householdId)
        && (
          request.auth.uid == uid
          || (
            exists(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId))
            && get(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId)).data.createdBy == uid
            && 'sharedWithUids' in resource.data
            && resource.data.sharedWithUids is list
            && request.auth.uid in resource.data.sharedWithUids
            && privateNoteSharedWithUidsValid(
              householdId,
              uid,
              resource.data.sharedWithUids
            )
            && 'note' in resource.data
            && resource.data.note is string
            && resource.data.note.size() >= 1
          )
        );

      allow list: if false;

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && exists(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId))
        && get(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId)).data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'note',
          'updatedAt',
          'sharedWithUids'
        ])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 180
        && request.resource.data.updatedAt == request.time
        && (!('sharedWithUids' in request.resource.data)
            || privateNoteSharedWithUidsValid(
              householdId,
              uid,
              request.resource.data.sharedWithUids
            ));

      allow delete: if isSignedIn()
        && request.auth.uid == uid
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && exists(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId))
        && get(/databases/$(database)/documents/households/$(householdId)/expenses/$(expenseId)).data.createdBy == request.auth.uid;
    }

    // Household-wide default split for NEW expenses only. Read by any
    // member; written by any member. `share0Bps` MUST be [0..10000]
    // bps inclusive. Both uids must currently exist as household members.
    // Document is immutable-by-omission: delete is disallowed, only
    // create/update with strict hasOnly.
    match /households/{householdId}/settings/defaults {
      allow read: if isSignedIn() && isHouseholdMember(householdId);

      allow create, update: if isSignedIn()
        && isHouseholdMember(householdId)
        && !isHouseholdReadOnly(householdId)
        && request.resource.data.keys().hasOnly([
          'share0Uid',
          'share1Uid',
          'share0Bps',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.share0Uid is string
        && request.resource.data.share1Uid is string
        && request.resource.data.share0Uid.size() > 0
        && request.resource.data.share1Uid.size() > 0
        && request.resource.data.share0Uid != request.resource.data.share1Uid
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.share0Uid))
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.resource.data.share1Uid))
        && request.resource.data.share0Bps is int
        && request.resource.data.share0Bps >= 0
        && request.resource.data.share0Bps <= 10000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}