<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: system splash (replaces default adaptive-icon + white icon plate) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/kidu_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_system_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/kidu_splash_bg</item>
    </style>
</resources>
